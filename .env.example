# Copy to .env and fill in from Supabase Project Settings → API
# Until set, the app uses built-in mock Kenya data (still fully usable).

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Production API used for guest viewing/purchase leads and protected server-side operations.
# Optional override. If omitted, app.json points to the deployed Nyumba API.
# Local dashboard/API: http://localhost:3000
# Production: https://nyumba-2-0.vercel.app
EXPO_PUBLIC_API_URL=http://localhost:3000
