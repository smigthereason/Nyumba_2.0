# Server-only production database credentials. NEVER expose the service role key to Expo/web clients.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Required in production. Generate a cryptographically random value >= 32 characters.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Comma-separated browser origins allowed to submit public leads.
# Native mobile requests do not send an Origin header.
ALLOWED_ORIGINS=https://nyumba.example,https://www.nyumba.example
